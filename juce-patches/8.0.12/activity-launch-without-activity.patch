+// AAP: a plugin process that a host app loads has no Activity to show the fragment in. Start the
+// plugin app's transparent JuceFragmentHostActivity instead (the plugin declares it in its
+// manifest), show the fragment once it is resumed, and finish it along with the overlay.
+static constexpr auto fragmentHostActivityClassName = "org.androidaudioplugin.juce.JuceFragmentHostActivity";
+
+static void showFragmentOverlay (jobject fragment, jobject activity)
+{
+    auto* env = getEnv();
+
+    LocalRef<jobject> fm (env->CallObjectMethod (activity, AndroidActivity.getFragmentManager));
+    env->CallVoidMethod (fragment, AndroidDialogFragment.show, fm.get(), javaString ("FragmentOverlay").get());
+}
+
+struct FragmentOverlay::HostActivity final : public ActivityLifecycleCallbacks,
+                                              private AndroidInterfaceImplementer
+{
+    explicit HostActivity (FragmentOverlay& o) : owner (o) {}
+
+    ~HostActivity() override
+    {
+        if (activity != nullptr)
+            getEnv()->CallVoidMethod (activity, AndroidActivity.finish);
+    }
+
+    bool start()
+    {
+        constexpr jint FLAG_ACTIVITY_NEW_TASK = 0x10000000;
+
+        auto* env = getEnv();
+        auto context = getAppContext();
+        const LocalRef<jstring> packageName ((jstring) env->CallObjectMethod (context, AndroidContext.getPackageName));
+        LocalRef<jobject> intent (env->NewObject (AndroidIntent, AndroidIntent.constructor));
+        env->CallObjectMethod (intent, AndroidIntent.setClassName, packageName.get(), javaString (fragmentHostActivityClassName).get());
+        env->CallObjectMethod (intent, AndroidIntent.setFlags, FLAG_ACTIVITY_NEW_TASK);
+        env->CallVoidMethod (context, AndroidContext.startActivity, intent.get());
+
+        // ActivityNotFoundException, if the plugin does not declare the activity.
+        if (jniCheckHasExceptionOccurredAndClear())
+            return false;
+
+        // Android silently drops the launch if it does not allow the process to start an activity
+        // from the background, e.g. if the host does not bind it with BIND_ALLOW_ACTIVITY_STARTS.
+        env->CallBooleanMethod (handler, AndroidHandler.postDelayed, timeout.get(), (jlong) 3000);
+        return true;
+    }
+
+    // The timeout Runnable that start() posts.
+    jobject invoke (jobject proxy, jobject method, jobjectArray args) override
+    {
+        auto* env = getEnv();
+
+        if (juceString ((jstring) env->CallObjectMethod (method, JavaMethod.getName)) != "run")
+            return AndroidInterfaceImplementer::invoke (proxy, method, args);
+
+        if (activity == nullptr)
+            owner.onHostActivityUnavailable(); // This may delete the owner and therefore this.
+
+        return nullptr;
+    }
+
+    void onActivityResumed (jobject resumed) override
+    {
+        if (activity != nullptr || ! isHostActivity (resumed))
+            return;
+
+        activity = GlobalRef (LocalRef<jobject> (getEnv()->NewLocalRef (resumed)));
+        showFragmentOverlay (owner.native, activity);
+    }
+
+    FragmentOverlay& owner;
+    GlobalRef activity;
+    GlobalRef handler { LocalRef<jobject> (getEnv()->NewObject (AndroidHandler, AndroidHandler.constructor)) };
+    GlobalRef timeout { CreateJavaInterface (this, "java/lang/Runnable") };
+    ActivityLifecycleCallbackForwarder forwarder { GlobalRef { getAppContext() }, this };
+};
+
+bool FragmentOverlay::isHostActivity (jobject activity)
+{
+    auto* env = getEnv();
+    const LocalRef<jobject> activityClass (env->GetObjectClass (activity));
+
+    return juceString (LocalRef<jstring> ((jstring) env->CallObjectMethod (activityClass, JavaClass.getName)))
+        == fragmentHostActivityClassName;
+}
