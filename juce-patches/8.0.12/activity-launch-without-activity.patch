     void onStart() override    { onRequestPermissionsResult (0, {}, {}); }
 
+    // AAP: there is no Activity to ask the user in (see FragmentOverlay::open()).
+    void onHostActivityUnavailable() override
+    {
+        for (;;)
+        {
+            std::vector<PermissionsRequest> unanswered;
+
+            {
+                ScopedLock lock (overlayGuard);
+
+                if (requests.empty())
+                {
+                    getSingleton() = nullptr;
+                    return;
+                }
+
+                unanswered.swap (requests);
+            }
+
+            for (const auto& request : unanswered)
+                if (request.callback)
+                    request.callback (RuntimePermissions::isGranted (request.permission));
+        }
+    }
