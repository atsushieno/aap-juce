 std::unique_ptr<ScopedMessageBoxInterface> ScopedMessageBoxInterface::create (const MessageBoxOptions& options)
 {
+    // AAP: a plugin editor is shown in a view that a host app embeds from another process, where
+    // there is no Activity for a native dialog. Re-use the AlertWindow as on Linux instead, whose
+    // result code is mapped to the button index as the native message boxes return.
+    if (getMainActivity() == nullptr)
+    {
+        class AlertWindowMessageBox final : public ScopedMessageBoxInterface
+        {
+        public:
+            explicit AlertWindowMessageBox (const MessageBoxOptions& o)
+                : inner (detail::AlertWindowHelpers::create (o)),
+                  numButtons (o.getNumButtons()) {}
+
+            void runAsync (std::function<void (int)> fn) override
+            {
+                inner->runAsync ([fn, n = numButtons] (int result) { fn (map (result, n)); });
+            }
+
+            int runSync() override
+            {
+                return map (inner->runSync(), numButtons);
+            }
+
+            void close() override
+            {
+                inner->close();
+            }
+
+        private:
+            static int map (int button, int numButtons)
+            {
+                if (numButtons <= 0)
+                    return 0;
+
+                return (button + numButtons - 1) % numButtons;
+            }
+
+            std::unique_ptr<ScopedMessageBoxInterface> inner;
+            int numButtons = 0;
+        };
+
+        return std::make_unique<AlertWindowMessageBox> (options);
+    }
+
