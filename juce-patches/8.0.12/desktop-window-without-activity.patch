+    // AAP: prefers the peer that has keyboard focus, so that a window opens in the editor that the
+    // user interacts with, if the process shows more than one.
+    static void* findViewToAttachToWithoutActivity()
+    {
+        const auto getViewToAttachTo = [] (ComponentPeer* p) -> jobject
+        {
+            auto* peer = dynamic_cast<AndroidComponentPeer*> (p);
+
+            if (peer == nullptr || (peer->getStyleFlags() & windowIsTemporary) != 0)
+                return nullptr;
+
+            // Attach to the editor rather than to another such window, which would clip the new one.
+            return peer->attachedWithoutActivity ? peer->viewGroup.get() : peer->view.get();
+        };
+
+        if (auto* focused = Component::getCurrentlyFocusedComponent())
+            if (auto v = getViewToAttachTo (focused->getPeer()))
+                return v;
+
+        auto& desktop = Desktop::getInstance();
+
+        for (auto i = desktop.getNumComponents(); --i >= 0;)
+            if (auto v = getViewToAttachTo (desktop.getComponent (i)->getPeer()))
