+        return Utils::makeWithEngineInplace<Detail::RecursiveEngine> (nativeInfo.uri);
+   #endif
+
     return Utils::makeWithEngineInplace<Detail::DirectoryIteratorEngine> (dir.getUrl().getLocalFile(), true);
 }
 
