include_guard(GLOBAL)

function(_aap_juce_file_hash path out_var)
    if(EXISTS "${path}")
        file(SHA256 "${path}" hash)
    else()
        set(hash missing)
    endif()
    set(${out_var} "${hash}" PARENT_SCOPE)
endfunction()

function(_aap_juce_check_path source_dir path)
    if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.?(/|$)|^\\.aap-juce(/|$)|[;\t\r\n]")
        message(FATAL_ERROR "Unsupported patch path: ${path}")
    endif()
    # Never follow a link out of the source tree while publishing staged files.
    set(cursor "${source_dir}/${path}")
    while(NOT cursor STREQUAL source_dir)
        if(IS_SYMLINK "${cursor}")
            message(FATAL_ERROR "Patch path traverses a symbolic link: ${cursor}")
        endif()
        get_filename_component(cursor "${cursor}" DIRECTORY)
    endwhile()
endfunction()

function(_aap_juce_prepare_tree source_dir)
    cmake_parse_arguments(PARSE_ARGV 1 arg "ADOPT_EXISTING_PATCHES;VERIFY_ONLY" "" "PATCHES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid AAP source preparation arguments")
    endif()
    if(NOT IS_DIRECTORY "${source_dir}")
        message(FATAL_ERROR "AAP source directory does not exist: ${source_dir}")
    endif()
    file(REAL_PATH "${source_dir}" source)
    # Both the lock and journal belong to the actual source, not an ABI build.
    set(state "${source}/.aap-juce")
    file(MAKE_DIRECTORY "${state}")
    file(LOCK "${state}/prepare.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot lock ${source}: ${lock_result}")
    endif()
    find_program(git NAMES git REQUIRED)
    execute_process(COMMAND "${git}" -C "${source}" rev-parse HEAD
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(revision AND NOT CMAKE_SCRIPT_MODE_FILE)
        execute_process(COMMAND "${git}" -C "${source}" symbolic-ref -q HEAD
            OUTPUT_VARIABLE reference OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        foreach(git_file HEAD packed-refs ${reference})
            execute_process(COMMAND "${git}" -C "${source}" rev-parse --git-path "${git_file}"
                OUTPUT_VARIABLE git_path OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            get_filename_component(git_path "${git_path}" ABSOLUTE BASE_DIR "${source}")
            if(EXISTS "${git_path}")
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${git_path}")
            endif()
        endforeach()
    endif()
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" implementation)
    set(identity "${source}\n${revision}\n${implementation}\n")
    set(paths)
    set(patches)
    foreach(patch IN LISTS arg_PATCHES)
        get_filename_component(patch "${patch}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${patch}")
            message(FATAL_ERROR "AAP patch does not exist: ${patch}")
        endif()
        file(SHA256 "${patch}" patch_hash)
        string(APPEND identity "${patch_hash}\n")
        list(APPEND patches "${patch}")
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
        endif()
        file(STRINGS "${patch}" headers REGEX "^diff --git ")
        if(NOT headers)
            message(FATAL_ERROR "AAP preparation requires git diff patches: ${patch}")
        endif()
        foreach(header IN LISTS headers)
            if(NOT header MATCHES "^diff --git a/(.+) b/(.+)$")
                message(FATAL_ERROR "Unsupported git diff header in ${patch}: ${header}")
            endif()
            list(APPEND paths "${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}")
        endforeach()
    endforeach()
    string(SHA256 fingerprint "${identity}")
    set(cached FALSE)
    if(EXISTS "${state}/current/fingerprint")
        file(READ "${state}/current/fingerprint" previous)
        if(previous STREQUAL fingerprint)
            set(cached TRUE)
        endif()
    endif()

    set(old_paths)
    set(upstream_changed FALSE)
    if(EXISTS "${state}/current/revision")
        file(READ "${state}/current/revision" old_revision)
        if(revision AND NOT revision STREQUAL old_revision)
            set(upstream_changed TRUE)
        endif()
    endif()
    if(EXISTS "${state}/current/manifest")
        file(STRINGS "${state}/current/manifest" records)
        foreach(record IN LISTS records)
            if(NOT record MATCHES "^([^\t]+)\t([^\t]+)\t(.+)$")
                message(FATAL_ERROR "Invalid AAP preparation journal: ${state}/current/manifest")
            endif()
            set(before "${CMAKE_MATCH_1}")
            set(after "${CMAKE_MATCH_2}")
            set(path "${CMAKE_MATCH_3}")
            _aap_juce_check_path("${source}" "${path}")
            string(SHA256 key "${path}")
            set(current_baseline_${key} FALSE)
            if(upstream_changed)
                execute_process(COMMAND "${git}" -C "${source}" ls-files --error-unmatch -- "${path}"
                    RESULT_VARIABLE tracked OUTPUT_QUIET ERROR_QUIET)
                execute_process(COMMAND "${git}" -C "${source}" diff --quiet HEAD -- "${path}"
                    RESULT_VARIABLE clean OUTPUT_QUIET ERROR_QUIET)
                if(tracked STREQUAL "0" AND clean STREQUAL "0")
                    # A clean file checked out at a new revision is a new baseline.
                    set(current_baseline_${key} TRUE)
                    set(cached FALSE)
                endif()
            endif()
            _aap_juce_file_hash("${source}/${path}" actual)
            if(NOT actual STREQUAL after)
                set(cached FALSE)
                if(NOT actual STREQUAL before AND NOT current_baseline_${key})
                    message(FATAL_ERROR
                        "AAP prepared file changed outside preparation: ${source}/${path}\n"
                        "Preserve your edits before restoring an unpatched source tree and "
                        "removing ${state}/current. No source files were overwritten.")
                endif()
            endif()
            _aap_juce_file_hash("${state}/current/original/${path}" saved)
            if(NOT saved STREQUAL before)
                message(FATAL_ERROR "AAP original-file backup is missing or corrupt: ${path}")
            endif()
            list(APPEND old_paths "${path}")
        endforeach()
    endif()
    if(cached)
        return()
    endif()
    if(arg_VERIFY_ONLY)
        message(FATAL_ERROR "AAP sources need preparation: ${source}. Run prepareAapJuce before native configuration.")
    endif()
    list(APPEND paths ${old_paths})
    list(REMOVE_DUPLICATES paths)

    # Validate the entire ordered series on scratch copies. A bad later patch
    # must not leave the real source half patched.
    set(transaction "${state}/transaction")
    file(REMOVE_RECURSE "${transaction}")
    file(MAKE_DIRECTORY "${transaction}/original" "${transaction}/patched")
    foreach(path IN LISTS paths)
        _aap_juce_check_path("${source}" "${path}")
        string(SHA256 key "${path}")
        if(path IN_LIST old_paths AND NOT current_baseline_${key})
            set(baseline "${state}/current/original/${path}")
        else()
            set(baseline "${source}/${path}")
        endif()
        if(EXISTS "${baseline}")
            if(IS_DIRECTORY "${baseline}")
                message(FATAL_ERROR "AAP patch targets a directory: ${path}")
            endif()
            get_filename_component(parent "${path}" DIRECTORY)
            file(MAKE_DIRECTORY "${transaction}/original/${parent}" "${transaction}/patched/${parent}")
            file(COPY "${baseline}" DESTINATION "${transaction}/original/${parent}")
            file(COPY "${baseline}" DESTINATION "${transaction}/patched/${parent}")
        endif()
    endforeach()
    if(arg_ADOPT_EXISTING_PATCHES AND NOT EXISTS "${state}/current/manifest")
        # A legacy Make build may already have applied some or all patches.
        # Reconstruct a baseline in scratch space only. Reverse in the opposite
        # order, reversing only patches Git proves are already present. The
        # complete forward pass below validates unapplied patches, including
        # patches that depend on earlier ones. Unrelated local edits survive.
        set(reverse_patches "${patches}")
        list(REVERSE reverse_patches)
        foreach(patch IN LISTS reverse_patches)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E env
                --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
                "GIT_CEILING_DIRECTORIES=${transaction}"
                "${git}" apply --reverse --check --ignore-space-change "${patch}"
                WORKING_DIRECTORY "${transaction}/original"
                RESULT_VARIABLE reversed OUTPUT_QUIET ERROR_QUIET)
            if(reversed STREQUAL "0")
                execute_process(COMMAND "${CMAKE_COMMAND}" -E env
                    --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
                    "GIT_CEILING_DIRECTORIES=${transaction}"
                    "${git}" apply --reverse --ignore-space-change --whitespace=nowarn "${patch}"
                    WORKING_DIRECTORY "${transaction}/original"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
                if(NOT result STREQUAL "0")
                    file(REMOVE_RECURSE "${transaction}")
                    message(FATAL_ERROR "Cannot safely adopt existing patch: ${patch}\n${output}${error}\nSource files are unchanged.")
                endif()
            endif()
        endforeach()
        file(REMOVE_RECURSE "${transaction}/patched")
        file(MAKE_DIRECTORY "${transaction}/patched")
        file(COPY "${transaction}/original/" DESTINATION "${transaction}/patched")
    endif()
    foreach(patch IN LISTS patches)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
            --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
            "GIT_CEILING_DIRECTORIES=${transaction}"
            "${git}" apply --ignore-space-change --whitespace=nowarn "${patch}"
            WORKING_DIRECTORY "${transaction}/patched"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result STREQUAL "0")
            file(REMOVE_RECURSE "${transaction}")
            message(FATAL_ERROR "AAP patch failed: ${patch}\n${output}${error}\nSource files are unchanged.")
        endif()
    endforeach()
    set(manifest "")
    foreach(path IN LISTS paths)
        _aap_juce_check_path("${transaction}/patched" "${path}")
        _aap_juce_file_hash("${transaction}/original/${path}" before)
        _aap_juce_file_hash("${transaction}/patched/${path}" after)
        string(APPEND manifest "${before}\t${after}\t${path}\n")
    endforeach()
    file(WRITE "${transaction}/manifest" "${manifest}")
    file(WRITE "${transaction}/fingerprint" "${fingerprint}")
    file(WRITE "${transaction}/revision" "${revision}")
    message(STATUS "Preparing AAP sources: ${source}")
    foreach(path IN LISTS paths)
        _aap_juce_file_hash("${source}/${path}" actual)
        _aap_juce_file_hash("${transaction}/patched/${path}" desired)
        if(NOT actual STREQUAL desired)
            file(REMOVE "${source}/${path}")
            if(EXISTS "${transaction}/patched/${path}")
                get_filename_component(parent "${source}/${path}" DIRECTORY)
                file(MAKE_DIRECTORY "${parent}")
                file(COPY "${transaction}/patched/${path}" DESTINATION "${parent}")
            endif()
        endif()
    endforeach()
    # Save backups only after publishing all outputs; never stamp a failed patch.
    file(REMOVE_RECURSE "${state}/current")
    file(RENAME "${transaction}" "${state}/current")
endfunction()
