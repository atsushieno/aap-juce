include_guard(GLOBAL)

function(aap_juce_detect_version source_dir out_var)
    set(header "${source_dir}/modules/juce_core/system/juce_StandardHeader.h")
    if(NOT EXISTS "${header}")
        message(FATAL_ERROR "Cannot detect JUCE version: ${header} does not exist")
    endif()
    file(READ "${header}" contents)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}")
    endif()
    foreach(component MAJOR_VERSION MINOR_VERSION BUILDNUMBER)
        if(NOT contents MATCHES "#define[ \t]+JUCE_${component}[ \t]+([0-9]+)")
            message(FATAL_ERROR "Cannot read JUCE_${component} from ${header}")
        endif()
        set(${component} "${CMAKE_MATCH_1}")
    endforeach()
    set(${out_var} "${MAJOR_VERSION}.${MINOR_VERSION}.${BUILDNUMBER}" PARENT_SCOPE)
endfunction()

# Explicit compatibility mappings: patch directories are not version ranges.
# Fix IDs also provide stable names for the DISABLE_FIXES escape hatch.
function(aap_juce_get_juce_patches out_var)
    cmake_parse_arguments(PARSE_ARGV 1 arg "EMBEDDED_JAVA" "VERSION;MODE"
        "DISABLE_FIXES;EXTRA_PATCHES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid aap_juce_get_juce_patches arguments")
    endif()
    if(NOT arg_MODE)
        set(arg_MODE PLUGIN)
    endif()
    if(NOT arg_MODE MATCHES "^(PLUGIN|HOST)$")
        message(FATAL_ERROR "MODE must be PLUGIN or HOST")
    endif()
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(fixes)
    foreach(optional popup lightweight bytecode)
        set(${optional} "")
    endforeach()
    if(arg_VERSION STREQUAL "6.0.5")
        set(ui "6.0.5/support-plugin-ui.patch")
        set(touch "6.0.5/juce-component-peer-view-touch.patch")
        set(lifecycle "6.0.5/component-peer-view-unregister-lifecycle-callbacks.patch")
        list(APPEND fixes cgwindow opengl)
        set(cgwindow "juce-patches/6.0.5/disable-cgwindowlistcreateimage.patch")
        set(opengl "juce-patches/6.0.5/android-opengl-local-bounds.patch")
    elseif(arg_VERSION MATCHES "^7\\.0\\.(9|10|11|12)$")
        set(ui "7.0.6/support-plugin-ui.patch")
        set(touch "7.0.11/juce-component-peer-view-touch.patch")
        set(lifecycle "7.0.11/component-peer-view-unregister-lifecycle-callbacks.patch")
        set(jni "juce-patches/7.0.6/export-jni-symbols.patch")
        set(detach "juce-patches/7.0.6/disable-detach-current-thread.patch")
        set(cgwindow "juce-patches/7.0.12/disable-cgwindowlistcreateimage.patch")
        set(popup "juce-patches/7.0.12/popup-menu-android.patch")
        set(bytecode "juce-patches/7.0.12/juce-component-peer-view-touch-bytecode.patch")
        list(APPEND fixes jni detach cgwindow)
    elseif(arg_VERSION MATCHES "^8\\.0\\.(9|10|12|15)$" OR arg_VERSION STREQUAL "9.0.0")
        if(arg_VERSION MATCHES "^8\\.0\\.(9|10)$")
            set(ui "8.0.10/support-plugin-ui.patch")
        else()
            set(ui "8.0.12/support-plugin-ui.patch")
        endif()
        set(touch "8.0.12/juce-component-peer-view-touch.patch")
        set(lifecycle "8.0.12/component-peer-view-unregister-lifecycle-callbacks.patch")
        set(jni "juce-patches/8.0.12/export-jni-symbols.patch")
        set(detach "juce-patches/8.0.12/disable-detach-current-thread.patch")
        set(peer "juce-patches/8.0.12/embedded-peer-window-guard.patch")
        set(popup "juce-patches/8.0.12/popup-menu-android.patch")
        set(lightweight "juce-patches/8.0.12/popup-menu-lightweight-android.patch")
        set(saf "juce-patches/9.0.0/android-document-iterator-saf.patch")
        if(arg_VERSION STREQUAL "8.0.15" OR arg_VERSION STREQUAL "9.0.0")
            set(lightweight "juce-patches/8.0.15/popup-menu-lightweight-android.patch")
            set(bytecode "juce-patches/8.0.15/juce-component-peer-view-touch-bytecode.patch")
        endif()
        if(arg_VERSION STREQUAL "9.0.0")
            set(popup "juce-patches/9.0.0/popup-menu-android.patch")
        endif()
        list(APPEND fixes jni detach peer)
    else()
        message(FATAL_ERROR
            "No predefined AAP JUCE patch set for ${arg_VERSION}. "
            "Use JUCE_PATCHES in aap_juce_configure() for an explicit override.")
    endif()

    if(arg_MODE STREQUAL "PLUGIN")
        set(plugin-ui "juce-patches/${ui}")
        list(APPEND fixes plugin-ui)
    elseif(NOT arg_VERSION STREQUAL "6.0.5")
        # thread-via-dalvik replaces the same detach block as detach.patch.
        list(REMOVE_ITEM fixes detach)
        set(thread "juce-patches/7.0.6/thread-via-dalvik.patch")
        list(APPEND fixes thread)
    endif()
    set(peer-touch "juce-patches/${touch}")
    set(peer-lifecycle "juce-patches/${lifecycle}")
    list(APPEND fixes peer-touch peer-lifecycle)
    if(popup)
        list(APPEND fixes popup)
    endif()
    if(lightweight)
        list(APPEND fixes lightweight saf)
    endif()
    if(arg_EMBEDDED_JAVA)
        if(NOT bytecode)
            message(FATAL_ERROR "No embedded Java patch for JUCE ${arg_VERSION}")
        endif()
        list(APPEND fixes bytecode)
    endif()

    set(entrypoint "JUCE-support-Android-CMake-hosting.patch")
    if(arg_MODE STREQUAL "PLUGIN")
        if(arg_VERSION VERSION_LESS "8.0.0")
            set(entrypoint "JUCE-support-Android-CMake.patch")
        else()
            set(factory "juce-patches/8.0.12/standalone-aap-factory-weak-fallback.patch")
            list(APPEND fixes factory)
        endif()
    endif()
    list(APPEND fixes entrypoint)
    foreach(disabled IN LISTS arg_DISABLE_FIXES)
        if(NOT disabled IN_LIST fixes)
            message(FATAL_ERROR "Unknown or inactive JUCE fix: ${disabled}")
        endif()
        list(REMOVE_ITEM fixes "${disabled}")
    endforeach()
    set(patches)
    foreach(fix IN LISTS fixes)
        list(APPEND patches "${root}/${${fix}}")
    endforeach()
    list(APPEND patches ${arg_EXTRA_PATCHES})
    set(${out_var} "${patches}" PARENT_SCOPE)
endfunction()
