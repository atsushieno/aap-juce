include_guard(GLOBAL)

# The cache lock lives outside the checkout so it also protects the first clone.
# Native configurations verify the completed source instead of populating it.
function(_aap_juce_populate out_source)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "SOURCE_DIR;SOURCE_CACHE;NAME;GIT_REPOSITORY;GIT_TAG;CUSTOM_CACHE_KEY" "PATCHES")
    list(REMOVE_ITEM arg_KEYWORDS_MISSING_VALUES SOURCE_CACHE)
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR
            NOT arg_SOURCE_DIR OR NOT arg_NAME OR NOT arg_GIT_REPOSITORY OR NOT arg_GIT_TAG)
        message(FATAL_ERROR "Population requires SOURCE_DIR, NAME, GIT_REPOSITORY and GIT_TAG")
    endif()
    file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" app_source)
    get_filename_component(destination "${arg_SOURCE_DIR}" ABSOLUTE BASE_DIR "${app_source}")
    if(NOT arg_SOURCE_CACHE)
        set(arg_SOURCE_CACHE "${app_source}/.aap-juce/dependencies")
    endif()
    get_filename_component(cache "${arg_SOURCE_CACHE}" ABSOLUTE BASE_DIR "${app_source}")
    file(MAKE_DIRECTORY "${cache}")
    file(REAL_PATH "${cache}" cache)
    string(REGEX REPLACE "(\\.git)?/$|\\.git$" "" repository "${arg_GIT_REPOSITORY}")
    set(identity "${repository}\n${arg_GIT_TAG}\n")
    foreach(patch IN LISTS arg_PATCHES)
        file(SHA256 "${patch}" patch_hash)
        string(APPEND identity "${patch_hash}\n")
    endforeach()
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PrepareSources.cmake" implementation)
    string(SHA256 profile "${identity}${implementation}")
    string(TOLOWER "${arg_NAME}" package)
    if(NOT arg_CUSTOM_CACHE_KEY)
        set(arg_CUSTOM_CACHE_KEY "aap")
    endif()
    set(key "${arg_CUSTOM_CACHE_KEY}-${profile}")
    set(source "${cache}/${package}/${key}")
    # A Java-only dependency may already occupy its upstream, in-tree location.
    # Preserve that checkout; never replace a real directory with a link.
    if(IS_DIRECTORY "${destination}" AND NOT IS_SYMLINK "${destination}")
        if(arg_PATCHES)
            message(FATAL_ERROR "Refusing to replace JUCE directory with a cache link: ${destination}")
        endif()
        set(source "${destination}")
    endif()
    set(patch_options)
    if(arg_PATCHES)
        list(APPEND patch_options PATCHES ${arg_PATCHES})
    endif()
    set(ready "${source}/.aap-juce/populated")
    file(MAKE_DIRECTORY "${cache}/.aap-juce-locks")
    file(LOCK "${cache}/.aap-juce-locks/${profile}.lock" GUARD FUNCTION TIMEOUT 600)
    set(native FALSE)
    if((ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android") AND NOT AAP_JUCE_PREPARE_ONLY)
        set(native TRUE)
    endif()
    if(native)
        if(NOT EXISTS "${ready}")
            message(FATAL_ERROR "Dependency ${arg_NAME} is not prepared. Run prepareAapJuce first.")
        endif()
        file(READ "${ready}" prepared_profile)
        if(NOT prepared_profile STREQUAL profile)
            message(FATAL_ERROR "Dependency ${arg_NAME} preparation does not match its recipe")
        endif()
        _aap_juce_prepare_tree("${source}" VERIFY_ONLY ${patch_options})
    else()
        if(EXISTS "${ready}")
            file(READ "${ready}" prepared_profile)
            if(NOT prepared_profile STREQUAL profile)
                message(FATAL_ERROR "Existing dependency recipe changed: ${source}")
            endif()
        elseif(NOT source STREQUAL destination)
            # Recover an interrupted clone only in our own content-addressed cache.
            if(NOT source STREQUAL destination AND EXISTS "${source}" AND
                    NOT EXISTS "${source}/.aap-juce/downloaded")
                file(REMOVE_RECURSE "${source}")
            endif()
            # CPM's bootstrap download needs its own lock across package recipes.
            file(MAKE_DIRECTORY "${cache}/cpm")
            file(LOCK "${cache}/cpm/aap-loader.lock" TIMEOUT 600)
            set(CPM_SOURCE_CACHE "${cache}")
            include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CPM.cmake")
            file(LOCK "${cache}/cpm/aap-loader.lock" RELEASE)
            CPMAddPackage(NAME "${arg_NAME}" GIT_REPOSITORY "${arg_GIT_REPOSITORY}"
                GIT_TAG "${arg_GIT_TAG}" CUSTOM_CACHE_KEY "${key}"
                DOWNLOAD_ONLY YES FORCE YES)
            if(NOT EXISTS "${source}/CMakeLists.txt")
                message(FATAL_ERROR "Incomplete dependency population: ${source}")
            endif()
            file(MAKE_DIRECTORY "${source}/.aap-juce")
            file(TOUCH "${source}/.aap-juce/downloaded")
        endif()
        if(NOT EXISTS "${source}/CMakeLists.txt")
            message(FATAL_ERROR "Incomplete dependency population: ${source}")
        endif()
        _aap_juce_prepare_tree("${source}" ADOPT_EXISTING_PATCHES ${patch_options})
        file(WRITE "${ready}.tmp" "${profile}")
        file(RENAME "${ready}.tmp" "${ready}")
    endif()
    if(NOT source STREQUAL destination)
        if(native)
            set(published_source "")
            if(EXISTS "${destination}")
                file(REAL_PATH "${destination}" published_source)
            endif()
            if(NOT published_source STREQUAL source)
                message(FATAL_ERROR "Dependency source link needs preparation: ${destination}")
            endif()
        else()
            set(published_source "")
            if(EXISTS "${destination}")
                file(REAL_PATH "${destination}" published_source)
            endif()
            if(NOT published_source STREQUAL source)
                get_filename_component(parent "${destination}" DIRECTORY)
                file(MAKE_DIRECTORY "${parent}")
                string(RANDOM LENGTH 12 nonce)
                set(link "${destination}.aap-${nonce}")
                file(CREATE_LINK "${source}" "${link}" SYMBOLIC RESULT result)
                if(NOT result STREQUAL "0")
                    message(FATAL_ERROR "Cannot publish dependency source link: ${result}")
                endif()
                file(RENAME "${link}" "${destination}")
            endif()
        endif()
    endif()
    set(${out_source} "${source}" PARENT_SCOPE)
endfunction()

function(aap_juce_fetch_dependency)
    _aap_juce_populate(source ${ARGV})
endfunction()
