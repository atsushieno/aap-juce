include_guard(GLOBAL)
get_filename_component(AAP_JUCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/JucePatchSets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PrepareSources.cmake")

function(_aap_juce_configure)
    cmake_parse_arguments(PARSE_ARGV 0 arg "EMBEDDED_JAVA;ADOPT_EXISTING_PATCHES" "APP_SOURCE_DIR;JUCE_SOURCE_DIR;JUCE_VERSION;MODE;AAP_DIR;ICON"
        "APP_PATCHES;JUCE_PATCHES;EXTRA_JUCE_PATCHES;DISABLE_JUCE_FIXES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid aap_juce_configure arguments")
    endif()
    if(NOT arg_MODE)
        set(arg_MODE PLUGIN)
    endif()
    if(NOT arg_MODE MATCHES "^(PLUGIN|HOST)$")
        message(FATAL_ERROR "MODE must be PLUGIN or HOST")
    endif()
    if(arg_APP_PATCHES AND NOT arg_APP_SOURCE_DIR)
        message(FATAL_ERROR "APP_PATCHES requires APP_SOURCE_DIR")
    endif()
    if(NOT arg_JUCE_SOURCE_DIR)
        message(FATAL_ERROR "aap_juce_configure requires JUCE_SOURCE_DIR")
    endif()
    get_filename_component(juce_source "${arg_JUCE_SOURCE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    aap_juce_detect_version("${juce_source}" version)
    if(arg_JUCE_VERSION AND NOT arg_JUCE_VERSION VERSION_EQUAL version)
        message(FATAL_ERROR "Expected JUCE ${arg_JUCE_VERSION}, found ${version}")
    endif()
    set(AAP_JUCE_VERSION "${version}" PARENT_SCOPE)
    set(AAP_JUCE_SOURCE_DIR "${juce_source}" PARENT_SCOPE)
    if(NOT arg_AAP_DIR)
        set(arg_AAP_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../aap-core")
    endif()
    get_filename_component(core "${arg_AAP_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set(AAP_DIR "${core}" PARENT_SCOPE)
    # Desktop metadata builds need the paths and version, but no Android preparation.
    # CMAKE_SYSTEM_NAME is available before project() initializes ANDROID.
    if(NOT (ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android" OR
            AAP_JUCE_PREPARE_ONLY OR CMAKE_SCRIPT_MODE_FILE))
        return()
    endif()
    if(DEFINED arg_JUCE_PATCHES)
        if(arg_EXTRA_JUCE_PATCHES OR arg_DISABLE_JUCE_FIXES OR arg_EMBEDDED_JAVA)
            message(FATAL_ERROR "JUCE_PATCHES overrides the catalog; do not combine it with catalog options")
        endif()
        set(patches "${arg_JUCE_PATCHES}")
        if(patches STREQUAL "NONE")
            set(patches "")
        endif()
    else()
        set(options)
        if(arg_EMBEDDED_JAVA)
            list(APPEND options EMBEDDED_JAVA)
        endif()
        if(arg_DISABLE_JUCE_FIXES)
            list(APPEND options DISABLE_FIXES ${arg_DISABLE_JUCE_FIXES})
        endif()
        if(arg_EXTRA_JUCE_PATCHES)
            list(APPEND options EXTRA_PATCHES ${arg_EXTRA_JUCE_PATCHES})
        endif()
        aap_juce_get_juce_patches(patches VERSION "${version}" MODE "${arg_MODE}"
            ${options})
    endif()
    set(prepare_options)
    if(arg_ADOPT_EXISTING_PATCHES)
        list(APPEND prepare_options ADOPT_EXISTING_PATCHES)
    endif()
    if(arg_APP_SOURCE_DIR)
        get_filename_component(app_source "${arg_APP_SOURCE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        file(REAL_PATH "${app_source}" app_source)
        file(REAL_PATH "${juce_source}" juce_source)
        if(app_source STREQUAL juce_source)
            message(FATAL_ERROR "APP_SOURCE_DIR and JUCE_SOURCE_DIR must be separate source trees")
        endif()
        set(app_options "${prepare_options}")
        if(arg_APP_PATCHES)
            list(APPEND app_options PATCHES ${arg_APP_PATCHES})
        endif()
        _aap_juce_prepare_tree("${app_source}" ${app_options})
        if(arg_APP_PATCHES AND NOT EXISTS "${app_source}/.stamp-app")
            file(TOUCH "${app_source}/.stamp-app")
        endif()
    endif()
    if(patches)
        list(APPEND prepare_options PATCHES ${patches})
    endif()
    _aap_juce_prepare_tree("${juce_source}" ${prepare_options})
    if(NOT EXISTS "${juce_source}/.stamp-juce")
        file(TOUCH "${juce_source}/.stamp-juce")
    endif()
    if(arg_ICON)
        get_filename_component(icon "${arg_ICON}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${icon}")
            message(FATAL_ERROR "AAP launcher icon does not exist: ${icon}")
        endif()
        file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" application_source)
        get_filename_component(port_root "${application_source}/../.." ABSOLUTE)
        configure_file("${icon}" "${port_root}/app/src/main/res/drawable/ic_launcher.png" COPYONLY)
    endif()
endfunction()

# A macro lets host preparation leave the calling CMakeLists.txt before project()
# and JUCE discover compilers or create native targets.
macro(aap_juce_configure)
    _aap_juce_configure(${ARGV})
    if(AAP_JUCE_PREPARE_ONLY)
        return()
    endif()
endmacro()

function(_aap_juce_target mode)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "TARGET;AAP_DIR" "")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT TARGET "${arg_TARGET}")
        message(FATAL_ERROR "aap_juce_${mode} requires an existing TARGET")
    endif()
    if(NOT COMMAND juce_add_module)
        message(FATAL_ERROR "Load JUCE before configuring an AAP target")
    endif()
    if(NOT arg_AAP_DIR)
        set(arg_AAP_DIR "${AAP_DIR}")
    endif()
    if(NOT IS_DIRECTORY "${arg_AAP_DIR}/include")
        message(FATAL_ERROR "AAP_DIR must point to aap-core (with its include directory)")
    endif()
    if(mode STREQUAL "plugin")
        set(module aap_audio_processors)
    else()
        set(module aap_audio_plugin_client)
    endif()
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    if(NOT TARGET "${module}")
        juce_add_module("${root}/aap-modules/${module}")
    endif()
    target_include_directories("${arg_TARGET}" PUBLIC "${arg_AAP_DIR}/include" "${root}/aap-modules")
    target_link_libraries("${arg_TARGET}" PRIVATE "${module}")
    if(mode STREQUAL "plugin")
        if(NOT AAP_JUCE_VERSION)
            message(FATAL_ERROR "Call aap_juce_configure before aap_juce_plugin")
        endif()
        if(AAP_JUCE_VERSION VERSION_LESS "7.0.0")
            target_compile_definitions("${arg_TARGET}" PUBLIC JUCEAAP_HAVE_AUDIO_PLAYHEAD_NEW_POSITION_INFO=0)
        else()
            target_compile_definitions("${arg_TARGET}" PUBLIC JUCEAAP_HAVE_AUDIO_PLAYHEAD_NEW_POSITION_INFO=1)
        endif()
    endif()
    if(ANDROID)
        if(NOT TARGET androidaudioplugin::androidaudioplugin)
            find_package(androidaudioplugin REQUIRED CONFIG)
        endif()
        target_link_libraries("${arg_TARGET}" PRIVATE androidaudioplugin::androidaudioplugin)
        target_compile_definitions("${arg_TARGET}" PUBLIC JUCE_DONT_AUTO_OPEN_MIDI_DEVICES_ON_MOBILE=1)
        if(mode STREQUAL "plugin")
            target_compile_definitions("${arg_TARGET}" PUBLIC JUCE_PUSH_NOTIFICATIONS=1
                JUCE_PUSH_NOTIFICATIONS_ACTIVITY="com/rmsl/juce/JuceActivity")
        endif()
    endif()
endfunction()

function(aap_juce_plugin)
    _aap_juce_target(plugin ${ARGV})
endfunction()

function(aap_juce_host)
    _aap_juce_target(host ${ARGV})
endfunction()
