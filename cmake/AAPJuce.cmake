include_guard(GLOBAL)
if(POLICY CMP0174)
    cmake_policy(SET CMP0174 NEW)
endif()
get_filename_component(AAP_JUCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/JucePatchSets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PrepareSources.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PopulateSources.cmake")

function(_aap_juce_configure)
    cmake_parse_arguments(PARSE_ARGV 0 arg "EMBEDDED_JAVA;ADOPT_EXISTING_PATCHES" "APP_SOURCE_DIR;JUCE_SOURCE_DIR;JUCE_VERSION;MODE;AAP_DIR;ICON;SOURCE_CACHE"
        "APP_PATCHES;JUCE_PATCHES;EXTRA_JUCE_PATCHES;DISABLE_JUCE_FIXES;JUCE_CPM_ARGS")
    list(REMOVE_ITEM arg_KEYWORDS_MISSING_VALUES SOURCE_CACHE)
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid aap_juce_configure arguments")
    endif()
    if(NOT arg_MODE)
        set(arg_MODE PLUGIN)
    endif()
    if(NOT arg_MODE MATCHES "^(PLUGIN|HOST)$")
        message(FATAL_ERROR "MODE must be PLUGIN or HOST")
    endif()
    if(arg_APP_PATCHES AND NOT arg_APP_SOURCE_DIR)
        message(FATAL_ERROR "APP_PATCHES requires APP_SOURCE_DIR")
    endif()
    if(NOT arg_JUCE_SOURCE_DIR)
        message(FATAL_ERROR "aap_juce_configure requires JUCE_SOURCE_DIR")
    endif()
    file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" application_source)
    get_filename_component(juce_source "${arg_JUCE_SOURCE_DIR}" ABSOLUTE BASE_DIR "${application_source}")
    if(arg_JUCE_CPM_ARGS)
        cmake_parse_arguments(recipe "" "GIT_TAG" "" ${arg_JUCE_CPM_ARGS})
        if(arg_JUCE_VERSION)
            set(version "${arg_JUCE_VERSION}")
        elseif(recipe_GIT_TAG MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)")
            set(version "${CMAKE_MATCH_1}")
        else()
            message(FATAL_ERROR "JUCE_VERSION is required when GIT_TAG does not contain a version")
        endif()
    else()
        aap_juce_detect_version("${juce_source}" version)
        if(arg_JUCE_VERSION AND NOT arg_JUCE_VERSION VERSION_EQUAL version)
            message(FATAL_ERROR "Expected JUCE ${arg_JUCE_VERSION}, found ${version}")
        endif()
    endif()
    if(NOT arg_AAP_DIR)
        set(arg_AAP_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../aap-core")
    endif()
    get_filename_component(core "${arg_AAP_DIR}" ABSOLUTE BASE_DIR "${application_source}")
    set(AAP_DIR "${core}" PARENT_SCOPE)
    # Target helpers may run in child directories or plugin factory functions.
    set(AAP_JUCE_EMBEDDED_JAVA "${arg_EMBEDDED_JAVA}" PARENT_SCOPE)
    # Existing desktop checkouts need no Android preparation.
    if(NOT arg_JUCE_CPM_ARGS AND NOT (ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android" OR
            AAP_JUCE_PREPARE_ONLY OR CMAKE_SCRIPT_MODE_FILE))
        set(AAP_JUCE_VERSION "${version}" PARENT_SCOPE)
        set(AAP_JUCE_SOURCE_DIR "${juce_source}" PARENT_SCOPE)
        return()
    endif()
    if(DEFINED arg_JUCE_PATCHES)
        if(arg_EXTRA_JUCE_PATCHES OR arg_DISABLE_JUCE_FIXES OR arg_EMBEDDED_JAVA)
            message(FATAL_ERROR "JUCE_PATCHES overrides the catalog; do not combine it with catalog options")
        endif()
        set(patches "${arg_JUCE_PATCHES}")
        if(patches STREQUAL "NONE")
            set(patches "")
        endif()
    else()
        set(options)
        if(arg_EMBEDDED_JAVA)
            list(APPEND options EMBEDDED_JAVA)
        endif()
        if(arg_DISABLE_JUCE_FIXES)
            list(APPEND options DISABLE_FIXES ${arg_DISABLE_JUCE_FIXES})
        endif()
        if(arg_EXTRA_JUCE_PATCHES)
            list(APPEND options EXTRA_PATCHES ${arg_EXTRA_JUCE_PATCHES})
        endif()
        aap_juce_get_juce_patches(patches VERSION "${version}" MODE "${arg_MODE}"
            ${options})
    endif()
    if(arg_JUCE_CPM_ARGS)
        set(population_patches)
        if(patches)
            list(APPEND population_patches PATCHES ${patches})
        endif()
        _aap_juce_populate(juce_source SOURCE_DIR "${juce_source}"
            SOURCE_CACHE "${arg_SOURCE_CACHE}" ${arg_JUCE_CPM_ARGS} ${population_patches})
    endif()
    aap_juce_detect_version("${juce_source}" detected_version)
    if(NOT version VERSION_EQUAL detected_version OR
            (arg_JUCE_VERSION AND NOT arg_JUCE_VERSION VERSION_EQUAL detected_version))
        message(FATAL_ERROR "Expected JUCE ${version}, found ${detected_version}")
    endif()
    set(AAP_JUCE_VERSION "${detected_version}" PARENT_SCOPE)
    set(AAP_JUCE_SOURCE_DIR "${juce_source}" PARENT_SCOPE)
    set(prepare_options)
    if((ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android") AND NOT AAP_JUCE_PREPARE_ONLY)
        list(APPEND prepare_options VERIFY_ONLY)
    elseif(arg_ADOPT_EXISTING_PATCHES)
        list(APPEND prepare_options ADOPT_EXISTING_PATCHES)
    endif()
    if(arg_APP_SOURCE_DIR)
        get_filename_component(app_source "${arg_APP_SOURCE_DIR}" ABSOLUTE BASE_DIR "${application_source}")
        file(REAL_PATH "${app_source}" app_source)
        file(REAL_PATH "${juce_source}" juce_source)
        if(app_source STREQUAL juce_source)
            message(FATAL_ERROR "APP_SOURCE_DIR and JUCE_SOURCE_DIR must be separate source trees")
        endif()
        set(app_options "${prepare_options}")
        if(arg_APP_PATCHES)
            list(APPEND app_options PATCHES ${arg_APP_PATCHES})
        endif()
        _aap_juce_prepare_tree("${app_source}" ${app_options})
        if(arg_APP_PATCHES AND NOT EXISTS "${app_source}/.stamp-app")
            file(TOUCH "${app_source}/.stamp-app")
        endif()
    endif()
    if(patches)
        list(APPEND prepare_options PATCHES ${patches})
    endif()
    if(NOT arg_JUCE_CPM_ARGS)
        _aap_juce_prepare_tree("${juce_source}" ${prepare_options})
    endif()
    if(NOT EXISTS "${juce_source}/.stamp-juce")
        file(TOUCH "${juce_source}/.stamp-juce")
    endif()
    if(arg_ICON AND NOT "VERIFY_ONLY" IN_LIST prepare_options)
        get_filename_component(icon "${arg_ICON}" ABSOLUTE BASE_DIR "${application_source}")
        if(NOT EXISTS "${icon}")
            message(FATAL_ERROR "AAP launcher icon does not exist: ${icon}")
        endif()
        file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" application_source)
        get_filename_component(port_root "${application_source}/../.." ABSOLUTE)
        configure_file("${icon}" "${port_root}/app/src/main/res/drawable/ic_launcher.png" COPYONLY)
    endif()
endfunction()

# A macro lets host preparation leave the calling CMakeLists.txt before project()
# and JUCE discover compilers or create native targets.
macro(aap_juce_configure)
    _aap_juce_configure(${ARGV})
    if(AAP_JUCE_PREPARE_ONLY)
        return()
    endif()
endmacro()

function(_aap_juce_target mode)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "TARGET;AAP_DIR" "TARGETS")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR
            (arg_TARGET AND arg_TARGETS) OR NOT (arg_TARGET OR arg_TARGETS))
        message(FATAL_ERROR "aap_juce_${mode} requires TARGET or TARGETS")
    endif()
    set(targets ${arg_TARGET} ${arg_TARGETS})
    foreach(target IN LISTS targets)
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "AAP target does not exist: ${target}")
        endif()
    endforeach()
    if(NOT COMMAND juce_add_module)
        message(FATAL_ERROR "Load JUCE before configuring an AAP target")
    endif()
    # Use the loaded JUCE, including when called from a nested target function.
    if(TARGET juce::juce_core)
        get_target_property(modules juce::juce_core INTERFACE_JUCE_MODULE_PATH)
        get_filename_component(juce_source "${modules}/.." ABSOLUTE)
        aap_juce_detect_version("${juce_source}" version)
    elseif(AAP_JUCE_VERSION)
        set(version "${AAP_JUCE_VERSION}")
    else()
        message(FATAL_ERROR "Cannot determine the loaded JUCE version")
    endif()
    if(NOT arg_AAP_DIR)
        set(arg_AAP_DIR "${AAP_DIR}")
    endif()
    if(NOT arg_AAP_DIR)
        set(arg_AAP_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../aap-core")
    endif()
    if(NOT IS_DIRECTORY "${arg_AAP_DIR}/include")
        message(FATAL_ERROR "AAP_DIR must point to aap-core (with its include directory)")
    endif()
    if(mode STREQUAL "plugin")
        set(module aap_audio_processors)
    else()
        set(module aap_audio_plugin_client)
    endif()
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    if(NOT TARGET "${module}")
        juce_add_module("${root}/aap-modules/${module}")
    endif()
    if(ANDROID)
        if(NOT TARGET androidaudioplugin::androidaudioplugin)
            find_package(androidaudioplugin REQUIRED CONFIG)
        endif()
        set(android_libraries)
        foreach(library log android GLESv2 EGL)
            find_library(aap_${library} NAMES "${library}" REQUIRED)
            list(APPEND android_libraries "${aap_${library}}")
        endforeach()
    endif()
    foreach(target IN LISTS targets)
        target_include_directories("${target}" PUBLIC "${arg_AAP_DIR}/include" "${root}/aap-modules")
        target_link_libraries("${target}" PRIVATE "${module}")
        target_compile_definitions("${target}" PUBLIC
            JUCEAAP_ENABLED=1
            JUCEAAP_HAVE_AUDIO_PLAYHEAD_NEW_POSITION_INFO=$<VERSION_GREATER_EQUAL:${version},7.0.0>
            JUCEAAP_AUDIO_PROCESSOR_CHANGE_DETAILS_UNAVAILABLE=$<VERSION_LESS:${version},6.1.0>
            JUCEAAP_USE_UNIQUE_ID=$<VERSION_GREATER_EQUAL:${version},6.1.0>
            JUCEAAP_HOSTED_PARAMETER=$<VERSION_GREATER_EQUAL:${version},6.1.3>
            AAP_JUCE_HAS_HEADLESS_PROCESSOR=$<VERSION_GREATER_EQUAL:${version},8.0.13>)
        if(ANDROID)
            target_link_libraries("${target}" PRIVATE androidaudioplugin::androidaudioplugin ${android_libraries})
            target_compile_definitions("${target}" PUBLIC
                JUCE_ANDROID=1
                JUCE_DONT_AUTO_OPEN_MIDI_DEVICES_ON_MOBILE=1
                JUCE_USE_ANDROID_OBOE_STABILIZED_CALLBACK=1)
            # Embedded-Java apps omit JuceActivity. Defining the activity macro
            # makes JUCE register its JNI callbacks at startup, which aborts
            # the process when the class is absent (even with notifications off).
            if(NOT AAP_JUCE_EMBEDDED_JAVA)
                target_compile_definitions("${target}" PUBLIC
                    JUCE_PUSH_NOTIFICATIONS=1
                    JUCE_PUSH_NOTIFICATIONS_ACTIVITY="com/rmsl/juce/JuceActivity")
            endif()
        endif()
    endforeach()
endfunction()

function(aap_juce_plugin)
    _aap_juce_target(plugin ${ARGV})
endfunction()

function(aap_juce_host)
    _aap_juce_target(host ${ARGV})
endfunction()
