cmake_minimum_required(VERSION 3.22)

include("${CMAKE_CURRENT_LIST_DIR}/AAPJuce.cmake")
if(DEFINED APP_CMAKE)
    if(NOT EXISTS "${APP_CMAKE}")
        message(FATAL_ERROR "Application CMakeLists.txt does not exist: ${APP_CMAKE}")
    endif()
    file(REAL_PATH "${APP_CMAKE}" app_cmake)
    get_filename_component(app_source "${app_cmake}" DIRECTORY)
    set(options ADOPT_EXISTING_PATCHES)
    if(APP_PATCH)
        if(NOT EXISTS "${APP_PATCH}")
            message(FATAL_ERROR "Application patch does not exist: ${APP_PATCH}")
        endif()
        file(SIZE "${APP_PATCH}" patch_size)
        if(patch_size GREATER 0)
            list(APPEND options PATCHES "${APP_PATCH}")
        endif()
    endif()
    _aap_juce_prepare_tree("${app_source}" ${options})
    if(patch_size GREATER 0 AND NOT EXISTS "${app_source}/.stamp-app")
        file(TOUCH "${app_source}/.stamp-app")
    endif()
    # Configure a compiler-free host project, so apps always use the same
    # add_subdirectory() integration in both host and native configuration.
    file(LOCK "${app_source}/.aap-juce/host-prepare.lock"
        GUARD PROCESS TIMEOUT 120 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot lock host preparation: ${lock_result}")
    endif()
    get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
    find_program(ninja NAMES ninja ninja-build HINTS "${cmake_bin}")
    set(generator_options)
    if(ninja)
        list(APPEND generator_options -G Ninja "-DCMAKE_MAKE_PROGRAM=${ninja}")
    endif()
    file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/prepare" prepare_source)
    string(SHA256 host_key "${prepare_source};${CMAKE_COMMAND};${ninja}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -S "${prepare_source}"
        -B "${app_source}/.aap-juce/host-prepare/${host_key}"
        ${generator_options}
        "-DAPP_CMAKE=${app_cmake}"
        RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "AAP host preparation failed: ${result}")
    endif()
    return()
endif()

# Retain the separate configuration-file interface for existing callers.
if(NOT DEFINED PORT_CONFIG OR NOT EXISTS "${PORT_CONFIG}")
    message(FATAL_ERROR "Pass -DAPP_CMAKE=/path/to/CMakeLists.txt or -DPORT_CONFIG=/path/to/config.cmake")
endif()
include("${PORT_CONFIG}")
if(NOT AAP_JUCE_PORT_CONFIG)
    message(FATAL_ERROR "${PORT_CONFIG} must define AAP_JUCE_PORT_CONFIG")
endif()
aap_juce_configure(${AAP_JUCE_PORT_CONFIG})

if(AAP_PORT_ICON)
    if(NOT AAP_PORT_ICON_DESTINATION OR NOT EXISTS "${AAP_PORT_ICON}")
        message(FATAL_ERROR "AAP_PORT_ICON requires an existing icon and AAP_PORT_ICON_DESTINATION")
    endif()
    get_filename_component(icon_directory "${AAP_PORT_ICON_DESTINATION}" DIRECTORY)
    file(MAKE_DIRECTORY "${icon_directory}")
    configure_file("${AAP_PORT_ICON}" "${AAP_PORT_ICON_DESTINATION}" COPYONLY)
endif()
